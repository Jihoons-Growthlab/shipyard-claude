{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "sqlite": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "db-mcp-server"
      ],
      "env": {
        "DB_TYPE": "sqlite",
        "DB_PATH": "/Users/hoon/Desktop/personal_project/shipyard-claude/database/shipyard.db",
        "DB_MODE": "read-only"
      }
    }
  }
}